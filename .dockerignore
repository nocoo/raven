# Dependencies and build output
node_modules/
**/node_modules/
**/.next/
coverage/
**/coverage/
*.tsbuildinfo

# Runtime secrets and persistent state
.env
.env.*
**/.env
**/.env.*
packages/proxy/data/
**/*.db*
**/*.sqlite*
**/github_token*
**/*.pem
**/*.key
**/*.bak
**/*.backup

# Repository-only files that are not build inputs
.git/
.github/
.husky/
.claude/
.superset/
docs/
assets/
# Test-only package trees. Never use bare **/test/ or **/e2e/: Next app
# route segments such as app/api/settings/socks5/test/ are build inputs.
packages/*/test/
packages/*/e2e/
scripts/__tests__/
*.md
logo.png
