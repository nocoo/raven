# Temporary install mirror; build-only and never written into the image or lockfile.
BUN_CONFIG_REGISTRY=https://packagefeedproxy.microsoft.io/npm/

# Generate both keys with: openssl rand -hex 32
RAVEN_API_KEY=replace-with-client-key
RAVEN_INTERNAL_KEY=replace-with-different-management-key

# Host-side Caddy normally keeps these loopback ports unchanged.
RAVEN_DASHBOARD_HOST_PORT=7023
RAVEN_PROXY_HOST_PORT=7024

# Optional GitHub Enterprise Cloud tenant. Leave empty for github.com.
RAVEN_GITHUB_HOST=

# Public API URL advertised by /api/connection-info.
RAVEN_BASE_URL=http://127.0.0.1:7024
RAVEN_LOG_LEVEL=info
RAVEN_COPILOT_PLAINTEXT_AGENT_TASKS=false
RAVEN_IP_LOOKUP_API_KEY=

# Local loopback-only mode works with these blank OAuth values.
# Any Dashboard exposed through Caddy beyond the host requires:
# HTTPS NEXTAUTH_URL + GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET +
# NEXTAUTH_SECRET + a non-empty ALLOWED_EMAILS allowlist.
NEXTAUTH_URL=http://127.0.0.1:7023
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=
USE_SECURE_COOKIES=
