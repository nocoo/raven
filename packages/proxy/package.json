{
  "name": "@raven/proxy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bunx --bun vitest run --coverage",
    "test:l2": "bunx --bun vitest run test/routes/",
    "test:watch": "bunx --bun vitest",
    "test:e2e": "bun test test/e2e/",
    "test:perf": "bun test test/perf/",
    "lint": "biome check --no-errors-on-unmatched --error-on-warnings --max-diagnostics=500 src test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "gpt-tokenizer": "4.0.0",
    "hono": "4.13.5",
    "socks": "^2.8.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.1",
    "@vitest/coverage-istanbul": "5.0.0",
    "vitest": "5.0.0"
  }
}
