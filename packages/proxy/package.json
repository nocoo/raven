{
  "name": "@raven/proxy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bunx --bun vitest run --coverage",
    "test:l2": "bunx --bun vitest run test/routes/",
    "test:watch": "bunx --bun vitest",
    "test:e2e": "bun test test/e2e/",
    "test:perf": "bun test test/perf/",
    "lint": "biome check --no-errors-on-unmatched --error-on-warnings --max-diagnostics=500 src test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "gpt-tokenizer": "^3.0.1",
    "hono": "4.13.1",
    "socks": "^2.8.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.2.9",
    "@vitest/coverage-istanbul": "4.1.10",
    "vitest": "4.1.10"
  }
}
