{
  "name": "dashboard",
  "version": "2.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 7023",
    "build": "tsc --noEmit && next build",
    "start": "next start -p 7023",
    "lint": "biome check --no-errors-on-unmatched --error-on-warnings --max-diagnostics=500 src test",
